{
  "name": "fhir_medallion_daily",
  "git_source": {
    "git_url": "https://github.com/naina-docs/fhir-medallion-lakehouse",
    "git_provider": "gitHub",
    "git_branch": "main"
  },
  "parameters": [
    {
      "name": "run_id",
      "default": "{{job.run_id}}"
    },
    {
      "name": "run_date",
      "default": ""
    },
    {
      "name": "lookback_days",
      "default": ""
    }
  ],
  "tasks": [
    {
      "task_key": "setup",
      "notebook_task": {
        "notebook_path": "notebooks/00_setup/setup_lakehouse",
        "source": "GIT"
      }
    },
    {
      "task_key": "patient_raw",
      "depends_on": [
        {
          "task_key": "setup"
        }
      ],
      "notebook_task": {
        "notebook_path": "notebooks/01_raw/ingest_raw",
        "source": "GIT",
        "base_parameters": {
          "resource": "Patient"
        }
      },
      "max_retries": 2,
      "min_retry_interval_millis": 300000,
      "retry_on_timeout": true
    },
    {
      "task_key": "patient_bronze",
      "depends_on": [
        {
          "task_key": "patient_raw"
        }
      ],
      "notebook_task": {
        "notebook_path": "notebooks/02_bronze/load_bronze",
        "source": "GIT",
        "base_parameters": {
          "resource": "Patient"
        }
      }
    },
    {
      "task_key": "patient_silver",
      "depends_on": [
        {
          "task_key": "patient_bronze"
        }
      ],
      "notebook_task": {
        "notebook_path": "notebooks/03_silver/load_silver",
        "source": "GIT",
        "base_parameters": {
          "resource": "Patient"
        }
      }
    },
    {
      "task_key": "encounter_raw",
      "depends_on": [
        {
          "task_key": "patient_silver"
        }
      ],
      "notebook_task": {
        "notebook_path": "notebooks/01_raw/ingest_raw",
        "source": "GIT",
        "base_parameters": {
          "resource": "Encounter"
        }
      },
      "max_retries": 2,
      "min_retry_interval_millis": 300000,
      "retry_on_timeout": true
    },
    {
      "task_key": "encounter_bronze",
      "depends_on": [
        {
          "task_key": "encounter_raw"
        }
      ],
      "notebook_task": {
        "notebook_path": "notebooks/02_bronze/load_bronze",
        "source": "GIT",
        "base_parameters": {
          "resource": "Encounter"
        }
      }
    },
    {
      "task_key": "encounter_silver",
      "depends_on": [
        {
          "task_key": "encounter_bronze"
        }
      ],
      "notebook_task": {
        "notebook_path": "notebooks/03_silver/load_silver",
        "source": "GIT",
        "base_parameters": {
          "resource": "Encounter"
        }
      }
    },
    {
      "task_key": "observation_raw",
      "depends_on": [
        {
          "task_key": "encounter_silver"
        }
      ],
      "notebook_task": {
        "notebook_path": "notebooks/01_raw/ingest_raw",
        "source": "GIT",
        "base_parameters": {
          "resource": "Observation"
        }
      },
      "max_retries": 2,
      "min_retry_interval_millis": 300000,
      "retry_on_timeout": true
    },
    {
      "task_key": "observation_bronze",
      "depends_on": [
        {
          "task_key": "observation_raw"
        }
      ],
      "notebook_task": {
        "notebook_path": "notebooks/02_bronze/load_bronze",
        "source": "GIT",
        "base_parameters": {
          "resource": "Observation"
        }
      }
    },
    {
      "task_key": "observation_silver",
      "depends_on": [
        {
          "task_key": "observation_bronze"
        }
      ],
      "notebook_task": {
        "notebook_path": "notebooks/03_silver/load_silver",
        "source": "GIT",
        "base_parameters": {
          "resource": "Observation"
        }
      }
    },
    {
      "task_key": "condition_raw",
      "depends_on": [
        {
          "task_key": "observation_silver"
        }
      ],
      "notebook_task": {
        "notebook_path": "notebooks/01_raw/ingest_raw",
        "source": "GIT",
        "base_parameters": {
          "resource": "Condition"
        }
      },
      "max_retries": 2,
      "min_retry_interval_millis": 300000,
      "retry_on_timeout": true
    },
    {
      "task_key": "condition_bronze",
      "depends_on": [
        {
          "task_key": "condition_raw"
        }
      ],
      "notebook_task": {
        "notebook_path": "notebooks/02_bronze/load_bronze",
        "source": "GIT",
        "base_parameters": {
          "resource": "Condition"
        }
      }
    },
    {
      "task_key": "condition_silver",
      "depends_on": [
        {
          "task_key": "condition_bronze"
        }
      ],
      "notebook_task": {
        "notebook_path": "notebooks/03_silver/load_silver",
        "source": "GIT",
        "base_parameters": {
          "resource": "Condition"
        }
      }
    },
    {
      "task_key": "gold",
      "depends_on": [
        {
          "task_key": "condition_silver"
        }
      ],
      "notebook_task": {
        "notebook_path": "notebooks/04_gold/build_gold",
        "source": "GIT"
      }
    },
    {
      "task_key": "quality",
      "depends_on": [
        {
          "task_key": "gold"
        }
      ],
      "notebook_task": {
        "notebook_path": "notebooks/05_quality/run_quality_checks",
        "source": "GIT"
      }
    }
  ],
  "schedule": {
    "quartz_cron_expression": "0 0 2 * * ?",
    "timezone_id": "UTC",
    "pause_status": "PAUSED"
  },
  "max_concurrent_runs": 1,
  "timeout_seconds": 7200,
  "tags": {
    "project": "fhir_medallion"
  }
}
